{
  "_comment": "archinstall 4.x config. The 'device' and root 'size' in disk_config are PATCHED AT RUNTIME by autostart.sh (device = user-picked target, root size = rest of disk). Packages list is regenerated by build-iso.sh from packages-pacman.txt.",
  "hostname": "arch-desktop",
  "kernels": [
    "linux"
  ],
  "timezone": "America/New_York",
  "locale_config": {
    "kb_layout": "us",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US"
  },
  "mirror_config": {
    "mirror_regions": {
      "United States": [
        "https://geo.mirror.pkgbuild.com/$repo/os/$arch"
      ]
    },
    "optional_repositories": [
      "multilib"
    ]
  },
  "network_config": {
    "type": "nm"
  },
  "bootloader_config": {
    "bootloader": "Systemd-boot",
    "uki": false,
    "removable": false
  },
  "services": [
    "NetworkManager",
    "sddm"
  ],
  "packages": [
    "coreutils",
    "curl",
    "wget",
    "git",
    "git-lfs",
    "jq",
    "tree",
    "htop",
    "ncdu",
    "ripgrep",
    "fd",
    "fzf",
    "entr",
    "dos2unix",
    "7zip",
    "gawk",
    "cloc",
    "bat",
    "eza",
    "zoxide",
    "duf",
    "wl-clipboard",
    "xclip",
    "fish",
    "tmux",
    "mosh",
    "vim",
    "neovim",
    "ghc",
    "cabal-install",
    "haskell-language-server",
    "lua",
    "luarocks",
    "uv",
    "gopls",
    "golangci-lint",
    "delve",
    "cmake",
    "ninja",
    "gdb",
    "clang",
    "pnpm",
    "base-devel",
    "autoconf",
    "automake",
    "openssl",
    "readline",
    "zlib",
    "libyaml",
    "libffi",
    "gdbm",
    "ncurses",
    "sqlite",
    "util-linux-libs",
    "postgresql-libs",
    "libvips",
    "imagemagick",
    "valkey",
    "postgresql",
    "networkmanager",
    "nmap",
    "mtr",
    "gnupg",
    "qrencode",
    "sddm",
    "sway",
    "waybar",
    "foot",
    "wofi",
    "mako",
    "swaybg",
    "swaylock",
    "swayidle",
    "grim",
    "slurp",
    "polkit-gnome",
    "gammastep",
    "cliphist",
    "dex",
    "pamixer",
    "playerctl",
    "brightnessctl",
    "xdg-desktop-portal-wlr",
    "podman",
    "graphviz",
    "ffmpeg",
    "direnv",
    "steam",
    "ttf-liberation",
    "gamemode",
    "mangohud",
    "lib32-mangohud",
    "lutris",
    "protontricks",
    "lib32-libpulse"
  ],
  "custom_commands": [
    "echo '[post-install] Stage 1 complete - run /root/post-install.sh after reboot'"
  ],
  "disk_config": {
    "config_type": "default_layout",
    "device_modifications": [
      {
        "device": "/dev/nvme1n1",
        "wipe": true,
        "partitions": [
          {
            "obj_id": "11111111-1111-4111-8111-111111111111",
            "status": "create",
            "type": "primary",
            "fs_type": "fat32",
            "flags": [
              "boot",
              "esp"
            ],
            "start": {
              "unit": "MiB",
              "value": 1,
              "sector_size": {
                "unit": "B",
                "value": 512
              }
            },
            "size": {
              "unit": "MiB",
              "value": 1024,
              "sector_size": {
                "unit": "B",
                "value": 512
              }
            },
            "mountpoint": "/boot",
            "mount_options": [],
            "dev_path": null,
            "btrfs": []
          },
          {
            "obj_id": "22222222-2222-4222-8222-222222222222",
            "status": "create",
            "type": "primary",
            "fs_type": "btrfs",
            "flags": [],
            "start": {
              "unit": "MiB",
              "value": 1025,
              "sector_size": {
                "unit": "B",
                "value": 512
              }
            },
            "size": {
              "unit": "GiB",
              "value": 900,
              "sector_size": {
                "unit": "B",
                "value": 512
              }
            },
            "mountpoint": "/",
            "mount_options": [],
            "dev_path": null,
            "btrfs": []
          }
        ]
      }
    ]
  }
}