{
  "_comment": "archinstall 4.x config. The 'device' and root 'size' in disk_config are PATCHED AT RUNTIME by autostart.sh (device = user-picked target, root size = rest of disk). Packages list is regenerated by build-iso.sh from packages-pacman.txt.",
  "hostname": "arch-desktop",
  "kernels": [
    "linux"
  ],
  "timezone": "America/New_York",
  "locale_config": {
    "kb_layout": "us",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US"
  },
  "mirror_config": {
    "mirror_regions": {
      "United States": [
        "https://geo.mirror.pkgbuild.com/$repo/os/$arch"
      ]
    },
    "optional_repositories": [
      "multilib"
    ]
  },
  "network_config": {
    "type": "nm"
  },
  "bootloader_config": {
    "bootloader": "Systemd-boot",
    "uki": false,
    "removable": false
  },
  "services": [
    "NetworkManager"
  ],
  "packages": [
    "git",
    "openssh",
    "networkmanager"
  ],
  "custom_commands": [
    "echo '[post-install] Stage 1 complete - run /root/post-install.sh after reboot'"
  ],
  "disk_config": {
    "config_type": "default_layout",
    "device_modifications": [
      {
        "device": "/dev/REPLACED-BY-AUTOSTART",
        "wipe": true,
        "partitions": [
          {
            "obj_id": "11111111-1111-4111-8111-111111111111",
            "status": "create",
            "type": "primary",
            "fs_type": "fat32",
            "flags": [
              "boot",
              "esp"
            ],
            "start": {
              "unit": "MiB",
              "value": 1,
              "sector_size": {
                "unit": "B",
                "value": 512
              }
            },
            "size": {
              "unit": "MiB",
              "value": 1024,
              "sector_size": {
                "unit": "B",
                "value": 512
              }
            },
            "mountpoint": "/boot",
            "mount_options": [],
            "dev_path": null,
            "btrfs": []
          },
          {
            "obj_id": "22222222-2222-4222-8222-222222222222",
            "status": "create",
            "type": "primary",
            "fs_type": "btrfs",
            "flags": [],
            "start": {
              "unit": "MiB",
              "value": 1025,
              "sector_size": {
                "unit": "B",
                "value": 512
              }
            },
            "size": {
              "unit": "GiB",
              "value": 900,
              "sector_size": {
                "unit": "B",
                "value": 512
              }
            },
            "mountpoint": "/",
            "mount_options": [],
            "dev_path": null,
            "btrfs": []
          }
        ]
      }
    ]
  }
}