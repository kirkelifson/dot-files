# sway config — dot-files Arch desktop.
# Installed to ~/.config/sway/config by post-install.sh.
# Sway reads this at startup; `swaymsg reload` applies edits live.
#
# Translated from the kit's original river init (riverctl → sway config).
# The programs spawned here are the ecosystem; rationale: ../README.md §4.

######## Basics ########
set $mod Mod4
set $term foot
set $browser firefox

font pango:monospace 12
default_border pixel 2
default_floating_border pixel 2
input type:keyboard {
    repeat_delay 300
    repeat_rate 50
}

# Focus follows mouse, but don't warp the cursor
focus_follows_mouse yes
mouse_warping none

# Gaps between windows — gives breathing room and shows the wallpaper
gaps inner 6
gaps outer 2
# Hide gaps + borders when only one window is on the workspace
smart_gaps on
smart_borders on

# Focused window border colour: cyan accent matching the bar
# class                 border  bg      text    indicator child_border
client.focused          #50b4b4 #1a1a1e #ffffff #50b4b4   #50b4b4
client.focused_inactive #333338 #1a1a1e #888888 #333338   #333338
client.unfocused        #222226 #1a1a1e #666666 #222226   #222226
client.urgent           #cc6666 #cc6666 #ffffff #cc6666   #cc6666

######## Displays (LG 27GP950-B: 4K 144 Hz VRR over DP with DSC) ########
output DP-1 mode 3840x2160@144Hz
output DP-1 adaptive_sync on
output DP-1 pos 0 0
output DP-1 scale 1

######## Autostart ########
# waybar       — status bar: workspaces, window title, clock, CPU/GPU temp, volume
exec waybar
# mako         — notification daemon (Wayland-native); history via makoctl
exec mako
# polkit-gnome — polkit agent: GUI auth prompts for privilege elevation
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
# swayidle     — idle daemon: aquarium 300s, lock 600s, DPMS off 900s, all gated by
#                idle-gate (skips while a non-screensaver window is fullscreen or mic live).
#                Manual Mod+Shift+L = fish replaces the lock view; first input brings the
#                real lock (idle-resume); unattended, the 600s auto-lock still fires.
#   300s resume clause is the input-driven lock trigger: swayidle has NO standalone
#   `resume` command — a trailing `resume X` binds to the LAST timeout (900s!), so
#   lock-on-input must hang off the 300s timer (watcher covers manual <5min returns).
exec swayidle -w timeout 300 '~/.config/sway/scripts/screensaver start' resume '~/.config/sway/scripts/idle-resume' timeout 600 '~/.config/sway/scripts/screensaver should-lock && swaylock -f' timeout 900 '~/.config/sway/scripts/screensaver should-lock && swaymsg output DP-1 dpms off'
# gammastep    — night light; starts off; Mod+n toggles on/off
exec gammastep -P -O 3400 -l 38.9:-77.0
# cliphist     — clipboard history: listener feeding cliphist from wl-paste
exec wl-paste --watch cliphist store
# copy-on-select: mirror the Wayland primary selection (select text in any
# terminal → it lands on the system clipboard for Ctrl+V elsewhere)
exec wl-paste -p -n --watch wl-copy
# autotile     — dwm-style dynamic splits (wide→horizontal, tall→vertical);
#                toggle with $mod+a. Manual b/v still works per-container.
exec /usr/bin/python3 ~/.config/sway/scripts/autotile
# foot server  — foot terminal: pre-forked server makes new windows instant
exec foot --server
# XDG autostart entries (portals etc.)
exec dex -a

######## Launcher / terminal / clipboard ########
bindsym $mod+Return exec $term
# browser: $mod+b is splith (i3-standard), so $mod+i
bindsym $mod+i exec $browser
bindsym $mod+d exec wofi --show drun
bindsym $mod+p exec sh -c 'cliphist list | wofi --dmenu | cliphist decode | wl-copy'
# Searchable keybinding cheat sheet; run selected exec bindings from the menu
bindsym $mod+slash exec ~/bin/sway-keys
# Lock: fish replaces the lock view; real lock lands on first input (or 600s idle)
bindsym $mod+Shift+l exec ~/.config/sway/scripts/screensaver start-force

######## Workspaces (dwm tags → sway workspaces 1..9) ########
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9

######## Focus / movement ########
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
# Focus between tiling / floating layers
bindsym $mod+Tab focus mode_toggle

######## Layout ########
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+e layout toggle split tabbed
# Resize inline (quick nudge)
bindsym $mod+h resize shrink width 40 px
bindsym $mod+l resize grow width 40 px

######## Resize mode (shows dimensions in waybar) ########
mode "resize" {
    bindsym h resize shrink width 20 px
    bindsym l resize grow width 20 px
    bindsym j resize grow height 20 px
    bindsym k resize shrink height 20 px
    bindsym Left resize shrink width 20 px
    bindsym Right resize grow width 20 px
    bindsym Down resize grow height 20 px
    bindsym Up resize shrink height 20 px
    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

######## Layout templates ########
# autotile on/off — dynamic dwm-style splits vs full manual control
bindsym $mod+a exec sh -c 'pgrep -f scripts/autotile >/dev/null && pkill -f scripts/autotile || /usr/bin/python3 ~/.config/sway/scripts/autotile'
# Whole-workspace presets (override autotile's per-container choices):
#   tabbed (full-height windows, like browser tabs)
bindsym $mod+t layout tabbed
#   stacked (title bars stacked vertically) — $mod+s is screenshot, so $mod+u
bindsym $mod+u layout stacking
#   back to auto/manual tiling
#   default tiling (splith) — NOTE: sway 1.12 dropped `layout default`
bindsym $mod+g layout splith
# retile now — group the workspace's terminals into one vertical stack,
# other apps beside them (one-shot; autotile daemon untouched)
bindsym $mod+Shift+t exec /usr/bin/python3 ~/.config/sway/scripts/autotile retile

######## Scratchpad (hidden stash for windows) ########
# Move focused window to scratchpad (hidden)
bindsym $mod+Shift+minus move scratchpad
# Show / cycle through scratchpad windows
bindsym $mod+minus scratchpad show

######## Mouse: move/resize floating views (left-drag / right-drag) ########
floating_modifier $mod

######## Float / fullscreen / close / exit ########
bindsym $mod+space floating toggle
bindsym $mod+f fullscreen toggle
# close window: $mod+q (Mod+Shift+c kept as alias; i3 muscle memory)
bindsym $mod+q kill
bindsym $mod+Shift+c kill
bindsym $mod+Shift+q exec swaynag -m "Exit sway?" -B "Exit" "swaymsg exit"
# Reload config in-place
bindsym $mod+Shift+r reload

######## Screenshots: grim+slurp — region / full, to file + clipboard ########
bindsym $mod+s exec ~/.config/sway/scripts/shot-region
bindsym $mod+Shift+s exec ~/.config/sway/scripts/shot-full

######## Media / brightness / night light ########
bindsym $mod+Next exec playerctl play-pause
bindsym $mod+Prior exec playerctl next
bindsym XF86AudioRaiseVolume exec pamixer -i 5
bindsym XF86AudioLowerVolume exec pamixer -d 5
bindsym XF86AudioMute exec pamixer -t
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym $mod+n exec ~/.config/sway/scripts/toggle-nightlight

######## Wallpaper ########
# Generated tiles live in ~/.config/sway/wallpapers/; regenerate with
# ~/.config/sway/scripts/generate-wallpapers and pick interactively with
# $mod+w or:  set-wallpaper <name>
output * bg ~/.config/sway/wallpapers/truchet.png tile
bindsym $mod+w exec ~/.config/sway/scripts/set-wallpaper

######## Rules ########
# Float dialog-ish windows
for_window [app_id="pavucontrol"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
for_window [title="Picture-in-Picture"] floating enable, sticky enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable
# Allow tearing for fullscreen games (opt-in; per-window in sway ≥1.12)
for_window [app_id="steam_app_*"] allow_tearing enable
# XWayland drag smoothness — render X11 windows 90ms before vblank instead of
# app-driven frame pacing; Steam's client shell drags were otherwise choppy
# (archinstall GPU idles at 16MHz, so the ramp-up stutters without this).
for_window [shell="xwayland"] max_render_time 90
# Mark urgent windows
for_window [urgent=latest] focus
