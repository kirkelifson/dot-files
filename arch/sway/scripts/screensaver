#!/usr/bin/env bash
# Fullscreen ASCII aquarium screensaver — eye candy + burn-in prevention.
#
# Modes:
#   start        auto (swayidle 300s): skipped when idle-gate inhibits
#                (fullscreen app or live call)
#   start-force  manual (Mod+Shift+L): ALWAYS starts — the fish REPLACES the
#                lock view. Session is technically unlocked while it shows;
#                the real lock lands on first input (idle-resume) and the
#                600s auto-lock is the safety net. Press 'q' in the fish to
#                dismiss it without locking (exit code 0); a crash exits
#                non-zero and locks instead — never a free unlock. Ctrl+C is
#                IGNORED (the wrapper traps SIGINT, so the fish inherits the
#                ignore): killing the fish via Ctrl+C left FLAG set on an
#                unlocked desktop, and the surprise lock outliving its
#                swaylock strands the session on sway's solid-red lock fill.
#   stop         kill fish + clear state
#   lock         guarded auto-lock (600s swayidle timeout): never stacks a
#                second lock client on one that is already running
#   should-lock  exit 0 when the 600s lock / 900s dpms timeouts may run:
#                fish active (user locked manually = intent) or gate clear.
#                CRITICAL: without the flag check, idle-gate would see the
#                fullscreen fish as "a game" and never let the safety-net
#                lock fire.
#
# State invariant: FLAG exists  <=>  fish was seen RUNNING.
# start-force waits synchronously for foot before touching FLAG, so idle-resume
# can trust it (async launch + immediate input was the "sometimes doesn't lock"
# bug). idle-resume claims an atomic mkdir lockfile before spawning swaylock so
# double resume sources (main swayidle + watcher) can't double-spawn.
set -u

BASE="$HOME/.config/sway/scripts"
RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
FLAG="$RUNTIME/screensaver.active"
WATCH_PID="$RUNTIME/screensaver-watch.pid"
CLAIM="$RUNTIME/screensaver.locking"
# foot window is tagged --app-id=screensaver so pkill can't hit anything else
# (swayidle's own cmdline mentions "screensaver" too — the app-id= prefix avoids it)
PATTERN='app-id=screensaver'

running() { [[ -n $(pgrep -f "$PATTERN") ]]; }

launch() {
    # foot -F = fullscreen on the focused output. The wrapper decides by
    # asciiquarium's exit code (verified live): 'q' exits 0 = intentional
    # dismissal -> clean up so the next input does NOT lock. ANY other exit
    # (a crash) -> idle-resume brings up the REAL lock. Dismissing by Ctrl+C
    # was the unlock bypass, so the wrapper traps SIGINT: sh ignores it and
    # the ignore is inherited by asciiquarium, making Ctrl+C a complete no-op.
    swaymsg exec "foot --app-id=screensaver -F sh -c 'trap \"\" INT; /usr/bin/asciiquarium; rc=\$?; if [ \$rc -eq 0 ]; then $BASE/screensaver stop; else $BASE/idle-resume; fi'"
}

kill_watcher() {
    [[ -f $WATCH_PID ]] && kill "$(cat "$WATCH_PID")" 2>/dev/null
    rm -f "$WATCH_PID"
}

arm_watcher() {
    # One-shot swayidle: arms after 2s idle, fires idle-resume on the next
    # input, then removes itself. Guarantees the real lock lands even if the
    # main swayidle's resume hadn't armed for this idle cycle.
    kill_watcher
    nohup sh -c "swayidle -w timeout 2 true resume '$BASE/screensaver resume-watcher' >/dev/null 2>&1 & echo \$! > '$WATCH_PID'" \
        >/dev/null 2>&1 &
}

case ${1:-} in
start)
    if running; then touch "$FLAG"; exit 0; fi   # already up — just arm state
    "$BASE/idle-gate" || exit 0                  # fullscreen app or call in progress
    command -v asciiquarium >/dev/null || exit 0 # not installed yet — no-op
    launch
    touch "$FLAG"
    ;;
start-force)
    # manual lock: deliberate keypress overrides the call/game gate
    if ! running; then
        if command -v asciiquarium >/dev/null; then
            launch
            # wait for foot to actually exist — FLAG must never lie
            for _ in $(seq 1 20); do
                running && break
                sleep 0.1
            done
        fi
        running || exec swaylock -f   # fish failed/missing — plain lock, always safe
    fi
    touch "$FLAG"
    arm_watcher
    ;;
resume-watcher)
    "$BASE/idle-resume"
    kill_watcher   # one-shot: never leave a 2s-cycle resume trigger behind
    ;;
stop)
    pkill -f "$PATTERN" || true   # exit 1 when nothing to kill — fine
    kill_watcher
    rm -f "$FLAG"
    rmdir "$CLAIM" 2>/dev/null
    ;;
lock)
    # guarded auto-lock for the 600s swayidle timeout: never stack a second
    # lock client on one that is already running (a failed acquire would exit
    # silently via -f's daemonize)
    pgrep -x swaylock >/dev/null || exec swaylock -f
    ;;
should-lock)
    [[ -f $FLAG ]] && exit 0
    exec "$BASE/idle-gate"
    ;;
*)
    echo "usage: $0 start|start-force|stop|should-lock" >&2
    exit 2
    ;;
esac
