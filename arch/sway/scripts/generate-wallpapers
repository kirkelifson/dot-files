#!/usr/bin/env python3
"""Generate seamless-tiling wallpapers with generative algorithms.

Usage:
    generate-wallpapers [OUTPUT_DIR]

Produces several 512x512 PNG tiles in OUTPUT_DIR (default: ~/.config/sway/wallpapers/).
Set one in sway with:  output * bg /path/to/tile.png tile
"""

import math, os, random, struct, sys
from pathlib import Path

try:
    from PIL import Image
except ImportError:
    sys.exit("Pillow not installed — pip install Pillow")

OUT = Path(sys.argv[1]) if len(sys.argv) > 1 else Path.home() / ".config/sway/wallpapers"
OUT.mkdir(parents=True, exist_ok=True)
SIZE = 512


# ── helpers ──────────────────────────────────────────────────────────────

def clamp(v, lo=0, hi=255):
    return max(lo, min(hi, int(v)))


# Permutation table for simplex/value noise (tiling-friendly)
def _perm(seed=0):
    rng = random.Random(seed)
    p = list(range(256))
    rng.shuffle(p)
    return p + p  # double for wrapping


def _value_noise_2d(x, y, perm, freq):
    """Tiling value noise: freq must be integer so it wraps at SIZE."""
    sx = x * freq / SIZE
    sy = y * freq / SIZE
    ix = int(sx) % freq
    iy = int(sy) % freq
    fx = sx - int(sx)
    fy = sy - int(sy)
    # smoothstep
    fx = fx * fx * (3 - 2 * fx)
    fy = fy * fy * (3 - 2 * fy)
    ix1 = (ix + 1) % freq
    iy1 = (iy + 1) % freq
    aa = perm[perm[ix] + iy] / 255
    ab = perm[perm[ix] + iy1] / 255
    ba = perm[perm[ix1] + iy] / 255
    bb = perm[perm[ix1] + iy1] / 255
    top = aa + fx * (ba - aa)
    bot = ab + fx * (bb - ab)
    return top + fy * (bot - top)


def fbm(x, y, perm, octaves=5, base_freq=4):
    """Fractal Brownian Motion — tiling across SIZE."""
    v = 0.0
    amp = 1.0
    freq = base_freq
    for _ in range(octaves):
        v += amp * _value_noise_2d(x, y, perm, freq)
        amp *= 0.5
        freq *= 2
    return v


# ── wallpaper generators ────────────────────────────────────────────────

def gen_nebula(path):
    """Domain-warped tiling fBm — nebula wisps with faint stars (numpy)."""
    import numpy as np

    W = H = SIZE

    def fbm(perm, base_freq=4, octaves=5, xoff=0.0, yoff=0.0):
        """Tiling fractal noise as a (W, H) field; offsets warp the domain."""
        perm = np.asarray(perm)
        v = np.zeros((W, H))
        amp = 1.0
        for octave in range(octaves):
            freq = base_freq * 2 ** octave
            # x/y may be scalars or (W, H) warp fields — always build 2D
            xs = (np.arange(W)[:, None] + xoff) * freq / W
            ys = (np.arange(H)[None, :] + yoff) * freq / H
            fx = xs - np.floor(xs)
            fy = ys - np.floor(ys)
            fx = fx * fx * (3 - 2 * fx)
            fy = fy * fy * (3 - 2 * fy)
            ix = np.floor(xs).astype(int) % freq
            iy = np.floor(ys).astype(int) % freq
            ix1 = (ix + 1) % freq
            iy1 = (iy + 1) % freq
            # hash lattice coords into the doubled permutation table
            aa = perm[perm[ix % 256] + iy % 256] / 255
            ba = perm[perm[ix1 % 256] + iy % 256] / 255
            ab = perm[perm[ix % 256] + iy1 % 256] / 255
            bb = perm[perm[ix1 % 256] + iy1 % 256] / 255
            top = aa + fx * (ba - aa)
            bot = ab + fx * (bb - ab)
            v += amp * (top + fy * (bot - top))
            amp *= 0.5
        return v

    rng = random.Random(5)
    perm_a = _perm(101)
    perm_b = _perm(102)
    perm_c = _perm(103)
    q1 = fbm(perm_a, 4, 4)
    q2 = fbm(perm_b, 4, 4)
    w = fbm(perm_c, 4, 6, xoff=90 * q1, yoff=90 * q2)
    w = (w - w.min()) / (w.max() - w.min())

    stars = np.random.default_rng(5).random((W, H))
    star = stars > 0.9997

    r = 16 + w * 100 + np.clip(q2 - 0.5, 0, 1) * 90
    g = 18 + w * 120
    b = 40 + w * 170 + np.clip(q1 - 0.5, 0, 1) * 60
    rgb = np.stack([np.clip(r, 0, 255), np.clip(g, 0, 255), np.clip(b, 0, 255)], -1)
    rgb[star] = (230, 230, 235)
    Image.fromarray(rgb.astype("uint8")).save(path)
    print(f"  {path.name}")


def gen_reaction_diffusion(path):
    """Gray-Scott reaction-diffusion (toroidal) — bold coral worms on teal."""
    import numpy as np

    N = 256
    rng = np.random.default_rng(7)
    a = np.ones((N, N))
    b = np.zeros((N, N))
    yy, xx = np.ogrid[:N, :N]
    for _ in range(14):
        cx, cy = rng.integers(0, N, 2)
        r = rng.integers(8, 14)
        b[((xx - cx) ** 2 + (yy - cy) ** 2) <= r * r] = 1.0

    Da, Db = 2.0, 1.0   # doubled diffusion → ~1.4x larger worm wavelength
    f, k = 0.030, 0.057  # labyrinth/worm regime (swept f,k pairs empirically)
    dt = 0.4             # 9-point stability limit: dt < 1/Da

    def lap9(u):
        # Karl Sims' 9-point Laplacian: 0.2 orthogonal + 0.05 diagonal.
        # A plain 5-point Laplacian is UNSTABLE at dt=1 (needs dt<0.25) and
        # collapses the pattern into 1px checkerboard mush.
        orth = (np.roll(u, 1, 0) + np.roll(u, -1, 0) +
                np.roll(u, 1, 1) + np.roll(u, -1, 1))
        diag = (np.roll(np.roll(u, 1, 0), 1, 1) + np.roll(np.roll(u, 1, 0), -1, 1) +
                np.roll(np.roll(u, -1, 0), 1, 1) + np.roll(np.roll(u, -1, 0), -1, 1))
        return 0.2 * orth + 0.05 * diag - u

    for _ in range(12000):
        ab2 = a * b * b
        a = np.clip(a + dt * (Da * lap9(a) - ab2 + f * (1 - a)), 0.0, 1.0)
        b = np.clip(b + dt * (Db * lap9(b) + ab2 - (k + f) * b), 0.0, 1.0)

    # Render: chemical B with hard contrast; toroidal gradient darkens edges
    v = (b - b.min()) / (b.max() - b.min())
    v = np.clip((v - 0.25) / 0.5, 0, 1) ** 0.8  # push midtones out
    gx = (np.roll(v, -1, 0) - np.roll(v, 1, 0)) / 2
    gy = (np.roll(v, -1, 1) - np.roll(v, 1, 1)) / 2
    edge = np.clip(np.hypot(gx, gy) * 6, 0, 1)
    r = 10 + v * 235
    g = 26 + v * 110 - edge * 18
    b_ = 34 + v * 60 + (1 - v) * 120 - edge * 30
    rgb = np.stack([np.clip(r, 0, 255), np.clip(g, 0, 255), np.clip(b_, 0, 255)], -1)
    img = Image.fromarray(rgb.astype("uint8"))
    # upscale with a WRAPPED pad so LANCZOS can't clamp at the torus seam
    pad = 4
    rgbp = np.pad(rgb, ((pad, pad), (pad, pad), (0, 0)), mode="wrap")
    big = Image.fromarray(rgbp.astype("uint8")).resize(
        (SIZE + 2 * pad * 2, SIZE + 2 * pad * 2), Image.LANCZOS)
    img = big.crop((2 * pad, 2 * pad, 2 * pad + SIZE, 2 * pad + SIZE))
    img.save(path)
    print(f"  {path.name}")


def gen_truchet(path):
    """Truchet tile mosaic — interlocking quarter-circle arcs."""
    from PIL import ImageDraw

    CELL = 32
    GRID = SIZE // CELL
    img = Image.new("RGB", (SIZE, SIZE), (18, 18, 24))
    draw = ImageDraw.Draw(img)
    rng = random.Random(99)
    colors = [(0, 180, 180), (120, 60, 180), (200, 80, 60), (60, 160, 90)]
    lw = 3
    for gy in range(GRID):
        for gx in range(GRID):
            x0 = gx * CELL
            y0 = gy * CELL
            c = colors[(gx + gy) % len(colors)]
            if rng.random() < 0.5:
                # arcs from top-left and bottom-right corners
                draw.arc([x0 - CELL // 2, y0 - CELL // 2,
                          x0 + CELL // 2, y0 + CELL // 2], 0, 90, fill=c, width=lw)
                draw.arc([x0 + CELL // 2, y0 + CELL // 2,
                          x0 + CELL + CELL // 2, y0 + CELL + CELL // 2], 180, 270, fill=c, width=lw)
            else:
                # arcs from top-right and bottom-left corners
                draw.arc([x0 + CELL // 2, y0 - CELL // 2,
                          x0 + CELL + CELL // 2, y0 + CELL // 2], 90, 180, fill=c, width=lw)
                draw.arc([x0 - CELL // 2, y0 + CELL // 2,
                          x0 + CELL // 2, y0 + CELL + CELL // 2], 270, 360, fill=c, width=lw)
    img.save(path)
    print(f"  {path.name}")


def gen_voronoi(path):
    """Tiling Voronoi cells — dark stained-glass look."""
    W = H = SIZE
    rng = random.Random(21)
    N = 60
    pts = [(rng.randint(0, W - 1), rng.randint(0, H - 1)) for _ in range(N)]
    # assign each point a colour
    palette = []
    for _ in range(N):
        palette.append((rng.randint(15, 50), rng.randint(40, 120), rng.randint(80, 170)))

    img = Image.new("RGB", (W, H))
    pix = img.load()
    for y in range(H):
        for x in range(W):
            best = float("inf")
            bi = 0
            for i, (px, py) in enumerate(pts):
                # toroidal distance for tiling
                dx = min(abs(x - px), W - abs(x - px))
                dy = min(abs(y - py), H - abs(y - py))
                d = dx * dx + dy * dy
                if d < best:
                    best = d
                    bi = i
            # darken edges: find second closest
            second = float("inf")
            for i, (px, py) in enumerate(pts):
                if i == bi:
                    continue
                dx = min(abs(x - px), W - abs(x - px))
                dy = min(abs(y - py), H - abs(y - py))
                d = dx * dx + dy * dy
                if d < second:
                    second = d
            edge = math.sqrt(second) - math.sqrt(best)
            if edge < 3:
                pix[x, y] = (8, 8, 12)
            else:
                c = palette[bi]
                # slight distance shading
                f = max(0.6, 1.0 - math.sqrt(best) / 200)
                pix[x, y] = (clamp(c[0] * f), clamp(c[1] * f), clamp(c[2] * f))
    img.save(path)
    print(f"  {path.name}")


def gen_hex_grid(path):
    """Hexagonal grid, perfect tiling via integer lattice periods.

    Flat-top hexagons: column-pair period P (so 3R = P exactly) and row
    period H (integer, ~sqrt(3)·R) — the tile is an exact multiple of both,
    unlike a radius-based layout where sqrt(3) leaves an uncloseable seam.
    """
    from PIL import ImageDraw

    P = 48            # column-pair period, px
    HP = 28           # row period, px
    NX, NY = 12, 20   # lattice periods per tile → 576x560
    W, HGT = P * NX, HP * NY
    R = P / 3.0       # hex circumradius = 16
    rx, ry = R - 1.0, HP / 2 - 1.0  # tiny gap so dark outlines show

    img = Image.new("RGB", (W, HGT), (10, 10, 16))
    draw = ImageDraw.Draw(img)
    perm = _perm(13)

    def hexnoise(col, row):
        # value noise over the hex index lattice, wrapped at tile periods —
        # both row terms must wrap, or border hexes change colour across seams
        cw = col % (2 * NX)
        rw = row % NY
        a = perm[(perm[cw] + rw) % 256] / 255
        b = perm[(perm[(cw + 5) % (2 * NX)] + rw) % 256] / 255
        return 0.65 * a + 0.35 * b

    # overdraw one lattice ring on every side; clipping crops it back
    for row in range(-1, NY + 1):
        for col in range(-1, 2 * NX + 1):
            cx = col * (P / 2)
            cy = row * HP + (HP / 2 if col % 2 else 0)
            n = hexnoise(col, row)
            t = n ** 1.4
            # slate → cyan, brighter hexes pulse toward teal-white
            r = 30 * (1 - t)
            g = 34 + t * 156
            b_ = 48 + t * 152
            verts = [(cx + rx * math.cos(math.radians(60 * a_)),
                      cy + ry * math.sin(math.radians(60 * a_)))
                     for a_ in range(6)]
            draw.polygon(verts, fill=(int(r), int(g), int(b_)),
                         outline=(8, 8, 12))
    img.save(path)
    print(f"  {path.name}")


# ── main ─────────────────────────────────────────────────────────────────

if __name__ == "__main__":
    print(f"Generating wallpapers in {OUT} …")
    gen_nebula(OUT / "nebula.png")
    gen_truchet(OUT / "truchet.png")
    gen_hex_grid(OUT / "hex-grid.png")
    gen_voronoi(OUT / "voronoi.png")
    gen_reaction_diffusion(OUT / "reaction-diffusion.png")
    print("Done. Set one with:")
    print(f"  swaymsg 'output * bg {OUT}/<name>.png tile'")
