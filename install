#!/usr/bin/env bash
set -e
dir="$(cd "$(dirname "$0")" && pwd)"
os="$(uname -s)"

# --- CI detection ---
# A CI run skips the slow/heavy steps below: bulk Homebrew/apt package
# installs and mise's language-runtime compilation. Auto-detected via the
# standard $CI variable (set by GitHub Actions and most other CI systems);
# set DOTFILES_CI=1 to force it elsewhere (e.g. a fast local relink).
is_ci() {
  [ -n "$CI" ] || [ -n "$DOTFILES_CI" ]
}

# Omarchy (Arch + Hyprland) manages its own terminal, tmux, and mise configs
# and rewrites them during `omarchy update`/`omarchy refresh`/theme changes.
# Several of those use `cp -f` or `sed -i`, which follow or break symlinks, so
# we avoid symlinking repo files over Omarchy-owned paths.
is_omarchy() {
  [ -d /usr/share/omarchy ] || command -v omarchy > /dev/null 2>&1
}

check_uncommitted_changes() {
  if command -v git > /dev/null 2>&1 && [ -d "$dir/.git" ]; then
    if [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]; then
      echo -e "[!] Warning: dot-files repo has uncommitted changes."
      echo -e "    You may want to commit or stash before running install."
      read -r -p "    Continue anyway? [y/N] " answer
      if [ "$answer" != "y" ] && [ "$answer" != "Y" ]; then
        echo -e "[!] Aborting."
        exit 0
      fi
    fi
  fi
}

# OS decides the package manager: Homebrew, FreeBSD pkg, apt, or pacman.
install_system_packages() {
  if is_ci; then
    echo -e "[+] CI detected, skipping system package installation."
    return
  fi

  if [ "$os" = "Darwin" ]; then
    if ! command -v brew > /dev/null 2>&1; then
      echo -e "[+] Homebrew not found. Installing..."
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
    if [ -f "$dir/Brewfile" ]; then
      echo -e "[+] Installing Homebrew packages from Brewfile."
      # No --no-lock: Homebrew dropped Brewfile.lock.json and now rejects the flag
      brew bundle --file="$dir/Brewfile"
    fi
  elif [ "$os" = "FreeBSD" ]; then
    install_freebsd_packages
  elif command -v apt-get > /dev/null 2>&1; then
    if [ -f "$dir/packages-apt.txt" ]; then
      echo -e "[+] Installing apt packages from packages-apt.txt."
      grep -v '^#' "$dir/packages-apt.txt" | grep -v '^$' | xargs sudo apt-get install -y
    fi
  elif command -v pacman > /dev/null 2>&1; then
    if [ -f "$dir/packages-pacman.txt" ]; then
      echo -e "[+] Installing pacman packages from packages-pacman.txt."
      grep -v '^#' "$dir/packages-pacman.txt" | grep -v '^$' | sudo pacman -S --needed --noconfirm -
    fi
  fi
}

# FreeBSD supports root bootstrapping as well as normal sudo-based installs.
run_as_root() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  else
    sudo "$@"
  fi
}

install_freebsd_packages() {
  run_as_root pkg update
  local package matches
  local packages=()
  while IFS= read -r package; do
    case "$package" in ""|\#*) continue ;; esac
    # Availability varies by FreeBSD release, architecture and pkg branch.
    # rquery matches the bare package name exactly; `pkg search -e` compares
    # against name-version (e.g. fish-4.0.2), so it never matched anything.
    if matches=$(pkg rquery '%n' "$package" 2>/dev/null) && [ -n "$matches" ]; then
      packages+=("$package")
    else
      echo "[!] FreeBSD package unavailable in this repository: $package (skipped)"
    fi
  done < "$dir/packages-freebsd.txt"
  if [ "${#packages[@]}" -gt 0 ]; then
    run_as_root pkg install -y "${packages[@]}"
  fi
  # These are required for the shared shell/editor/session configuration.
  local required
  for required in fish git vim tmux fzf fd mise curl; do
    command -v "$required" > /dev/null 2>&1 || {
      echo "[!] Required FreeBSD command missing: $required" >&2
      return 1
    }
  done
}

# Preserve every previous backup, including dangling symlinks.
backup_path() {
  local source="$1" backup="$2" candidate="$2" index=1
  while [ -e "$candidate" ] || [ -L "$candidate" ]; do
    candidate="$backup.$index"
    index=$((index + 1))
  done
  echo "[>] Saving $source to $candidate"
  mv "$source" "$candidate"
}

# Soft-link all dotfiles/bin into $HOME. (.vim is handled separately below —
# it has runtime dirs (pack/, tmp/, undo/) that shouldn't live in the repo.)
link_dotfiles() {
  echo -e "[+] Creating soft-links to dot-files."

  local dotfile basename target
  for dotfile in $(find "$dir" -maxdepth 1 -name ".*" \
    | grep -v '\.git$' \
    | grep -v '\.github$' \
    | grep -v '\.config$' \
    | grep -v '\.vim$'); do
    basename="$(basename "$dotfile")"
    target="$HOME/$basename"
    # Back up existing non-symlink files/directories before linking
    if [ -e "$target" ] && [ ! -L "$target" ]; then
      backup_path "$target" "${target}-backup"
    fi
    echo -e "\t[>] Linking $dotfile"
    ln -sfn "$dotfile" "$target"
  done

  # .vim: copy repo contents (syntax files) and ensure runtime dirs exist
  if [ -d "$dir/.vim" ]; then
    echo -e "\t[>] Setting up ~/.vim"
    mkdir -p ~/.vim
    cp -r "$dir/.vim/syntax" ~/.vim/ 2>/dev/null || true
  fi

  # Sublime Text
  if [ -d "/Applications/Sublime Text.app" ]; then
    if [ ! -f "$dir/bin/subl" ]; then
      ln -s "/Applications/Sublime Text.app/Contents/SharedSupport/bin/subl" "$dir/bin/subl"
    fi
  fi

  echo -e "\t[>] Linking $dir/bin"
  ln -sfn "$dir/bin" ~
}

link_config_dir() {
  local name="$1"
  if [ -d "$dir/.config/$name" ]; then
    if [ -e "$HOME/.config/$name" ] && [ ! -L "$HOME/.config/$name" ]; then
      backup_path "$HOME/.config/$name" "$HOME/.config/$name-backup"
    fi
    echo -e "\t[>] Linking $name config"
    ln -sfn "$dir/.config/$name" "$HOME/.config/$name"
  fi
}

link_config_dirs() {
  echo -e "[+] Setting up .config directories."
  mkdir -p ~/.config

  link_config_dir fish
  link_mise_config

  # Ghostty: macOS uses ~/Library/Application Support/com.mitchellh.ghostty/
  # Linux uses ~/.config/ghostty/
  if [ -d "$dir/.config/ghostty" ]; then
    if is_omarchy; then
      # Omarchy's ghostty config pulls in the active theme and is edited in
      # place by `omarchy font set` / text-size. Replacing it breaks theming.
      echo -e "\t[>] Omarchy detected, leaving its ghostty config alone"
    elif [ "$os" = "Darwin" ]; then
      local ghostty_dir="$HOME/Library/Application Support/com.mitchellh.ghostty"
      mkdir -p "$ghostty_dir"
      if [ -e "$ghostty_dir/config" ] && [ ! -L "$ghostty_dir/config" ]; then
        backup_path "$ghostty_dir/config" "$ghostty_dir/config.backup"
      fi
      echo -e "\t[>] Linking ghostty config (macOS)"
      ln -sf "$dir/.config/ghostty/config" "$ghostty_dir/config"
    else
      link_config_dir ghostty
    fi
  fi

  setup_omarchy_tmux
}

# The repo's mise versions go in conf.d instead of replacing the whole
# ~/.config/mise dir, preserving Omarchy and local settings. mise owns tool
# selection; global writes may update this linked repo fragment. Project
# mise.toml files remain local to their projects.
link_mise_config() {
  local mise_dir="$HOME/.config/mise"
  [ -f "$dir/.config/mise/config.toml" ] || return

  # Migrate from the old layout where ~/.config/mise was a symlink to the repo
  if [ -L "$mise_dir" ]; then
    rm "$mise_dir"
  fi
  mkdir -p "$mise_dir/conf.d"
  echo -e "\t[>] Linking mise config (conf.d/dot-files.toml)"
  ln -sfn "$dir/.config/mise/config.toml" "$mise_dir/conf.d/dot-files.toml"
}

# tmux reads ~/.tmux.conf before ~/.config/tmux/tmux.conf, so the repo config
# already wins. But Omarchy's tooling (`omarchy restart tmux`, update
# migrations) sources ~/.config/tmux/tmux.conf into the running server, which
# would layer Omarchy's bindings on top of ours. Point that file at ours with a
# one-line regular file (not a symlink: `omarchy refresh tmux` does `cp -f`,
# which would write through a symlink into the repo).
setup_omarchy_tmux() {
  is_omarchy || return 0
  local cfg="$HOME/.config/tmux/tmux.conf"
  local stub="source-file ~/.tmux.conf"

  if [ -f "$cfg" ] && [ ! -L "$cfg" ] && grep -qxF "$stub" "$cfg"; then
    return
  fi

  mkdir -p "$(dirname "$cfg")"
  if [ -e "$cfg" ] || [ -L "$cfg" ]; then
    backup_path "$cfg" "$cfg.omarchy-default"
  fi
  echo -e "\t[>] Pointing Omarchy's tmux config at ~/.tmux.conf"
  printf '# Managed by dot-files/install: Omarchy tools source this file.\n%s\n' "$stub" > "$cfg"
}

setup_vim_packages() {
  mkdir -p ~/.vim/tmp ~/.vim/undo

  if [ ! -d ~/.vim/pack/bundle/start ]; then
    echo -e "[+] Adding vim packages."
    mkdir -p ~/.vim/pack/bundle/start
    git clone https://github.com/AlessandroYorba/Sierra ~/.vim/pack/bundle/start/Sierra &> /dev/null
    git clone https://github.com/itchyny/lightline.vim ~/.vim/pack/bundle/start/lightline.vim &> /dev/null
    git clone https://github.com/ervandew/supertab.git ~/.vim/pack/bundle/start/supertab &> /dev/null
    git clone https://github.com/airblade/vim-gitgutter ~/.vim/pack/bundle/start/vim-gitgutter &> /dev/null
  else
    echo -e "[+] Updating vim packages."
    local package
    for package in ~/.vim/pack/bundle/start/*/; do
      git -C "$package" pull &> /dev/null
    done
  fi
}

install_fonts() {
  # GohuFont Nerd Font (TTF, works on macOS + Linux)
  local nerd_fonts_version="v3.4.0"
  local gohu_url="https://github.com/ryanoasis/nerd-fonts/releases/download/${nerd_fonts_version}/Gohu.tar.xz"
  local font_dir

  if [ "$os" = "Darwin" ]; then
    font_dir="$HOME/Library/Fonts"
  else
    font_dir="$HOME/.local/share/fonts"
  fi
  mkdir -p "$font_dir"

  if ls "$font_dir"/GohuFont*NerdFontMono* > /dev/null 2>&1; then
    echo -e "[+] GohuFont Nerd Font already installed."
    return
  fi

  echo -e "[+] Installing GohuFont Nerd Font..."
  local tmpdir
  tmpdir=$(mktemp -d)
  if curl -fsSL "$gohu_url" -o "$tmpdir/Gohu.tar.xz"; then
    tar -xJf "$tmpdir/Gohu.tar.xz" \
      -C "$tmpdir" \
      GohuFont11NerdFontMono-Regular.ttf \
      GohuFont14NerdFontMono-Regular.ttf \
      2>/dev/null
    cp "$tmpdir"/GohuFont*NerdFontMono*.ttf "$font_dir"/ 2>/dev/null || true
    command -v fc-cache > /dev/null 2>&1 && fc-cache -f "$font_dir"
    echo -e "\t[>] GohuFont Nerd Font installed to $font_dir"
  else
    echo -e "\t[!] Could not download GohuFont. Install manually from https://font.gohu.org/"
  fi
  rm -rf "$tmpdir"
}

setup_fish_shell() {
  # Install fish if missing
  if ! command -v fish > /dev/null 2>&1; then
    # Homebrew may have just installed it but it's not in this bash session's PATH
    if [ "$os" = "Darwin" ] && [ -x /opt/homebrew/bin/fish ]; then
      export PATH="/opt/homebrew/bin:$PATH"
    fi
  fi

  if ! command -v fish > /dev/null 2>&1; then
    echo -e "[+] Fish shell not found. Installing..."
    if [ "$os" = "Darwin" ] && command -v brew > /dev/null 2>&1; then
      brew install fish
      export PATH="/opt/homebrew/bin:$PATH"
    elif [ "$os" = "FreeBSD" ]; then
      run_as_root pkg install -y fish
    elif command -v apt-get > /dev/null 2>&1; then
      sudo apt-get install -y fish
    elif command -v pacman > /dev/null 2>&1; then
      sudo pacman -S --needed --noconfirm fish
    else
      echo -e "[!] Could not install fish. Install it manually and re-run."
    fi
  fi

  if ! command -v fish > /dev/null 2>&1; then
    return
  fi

  local fish_path
  fish_path=$(command -v fish)
  echo -e "[+] Setting up fish shell ($fish_path)."

  # Add fish to /etc/shells if not present
  if ! grep -q "^${fish_path}$" /etc/shells 2>/dev/null; then
    echo -e "\t[>] Adding fish to /etc/shells (requires sudo)"
    echo "$fish_path" | sudo tee -a /etc/shells > /dev/null
  fi

  # Detect current shell (macOS uses dscl, Linux uses getent)
  local current_shell=""
  if [ "$os" = "Darwin" ]; then
    current_shell=$(dscl . -read /Users/"$USER" UserShell 2>/dev/null | awk '{print $2}')
  else
    current_shell=$(getent passwd "$USER" 2>/dev/null | cut -d: -f7)
  fi
  current_shell="${current_shell:-$SHELL}"

  if [ "$current_shell" != "$fish_path" ]; then
    if is_ci; then
      echo -e "\t[>] CI detected, skipping chsh (no valid account password to authenticate it)."
      return
    fi
    echo -e "\t[>] Changing default shell to fish"
    chsh -s "$fish_path"
    echo -e "\t[!] Default shell changed. Please restart your terminal."
  else
    echo -e "\t[>] Fish is already the default shell"
  fi
}

install_mise_runtimes() {
  if [ "$os" = "FreeBSD" ]; then
    echo "[+] FreeBSD: mise is supplied by pkg; automatic runtime installs are skipped."
    echo "    Use project mise.toml files and install supported tools individually (see README)."
    return
  fi
  if ! command -v mise > /dev/null 2>&1; then
    if [ -x "$HOME/.local/bin/mise" ]; then
      export PATH="$HOME/.local/bin:$PATH"
    else
      echo -e "[+] mise not found. Installing..."
      curl -fsSL https://mise.run | sh
      export PATH="$HOME/.local/bin:$PATH"
    fi
  fi

  if is_ci; then
    echo -e "[+] CI detected, skipping mise language runtime installation."
    return
  fi

  if command -v mise > /dev/null 2>&1; then
    echo -e "[+] Installing language runtimes via mise (merged global and project configs)."
    mise install
  fi
}

# --- Main ---
if [ "$os" = "FreeBSD" ]; then
  export PATH="/usr/local/bin:/usr/local/sbin:$PATH"
fi
check_uncommitted_changes
echo -e "Installing dot-files:"
install_system_packages
link_dotfiles
link_config_dirs
setup_vim_packages
install_fonts
setup_fish_shell
install_mise_runtimes
echo -e "[!] Restart terminal session for changes to take effect."
