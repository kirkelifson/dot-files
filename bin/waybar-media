#!/usr/bin/env python3
"""waybar-media: now-playing waybar module (MPRIS via playerctl).

Continuous mode (no args): polls all MPRIS players once a second and emits
{text,class,tooltip} JSON lines when anything changes. The bar shows the
track title (never the app name) next to a play glyph.
Firefox's single MPRIS bus points at a stale session when several tabs play
(upstream bug 1710229: pausing one tab doesn't move the bus to the tab
that's still playing), so an app with audio actually FLOWING (uncorked
PulseAudio sink-input) but no "Playing" MPRIS player also counts as playing.
"click" mode: toggles play/pause on the MPRIS player shown in the bar
(state file written by the loop; falls back to playerctl's active player).
"""
import json
import os
import re
import signal
import subprocess
import sys
import time

FMT = "{{playerName}}\t{{status}}\t{{artist}}\t{{title}}"
POLL = 1.0  # seconds between playerctl sweeps
STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
                     "waybar-media.player")


def snapshot():
    """All MPRIS players as dicts: name, status, track."""
    try:
        out = subprocess.run(["playerctl", "-a", "metadata", "-f", FMT],
                             capture_output=True, text=True, timeout=5).stdout
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return []
    players = []
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) != 4 or not parts[0]:
            continue
        name, status, artist, title = parts
        # skip the artist when the title already leads with it ("x - x - song")
        if artist and title.lower().startswith(artist.lower() + " - "):
            artist = ""
        track = " - ".join(x for x in (artist, title) if x) or "unknown track"
        players.append({"name": name, "status": status, "track": track})
    return players


def audio_streams():
    """(app, media.name) for every UNCORKED sink-input — streams actually
    producing audio right now. media.name carries the real tab title even
    when the app's MPRIS bus points at a stale session."""
    try:
        out = subprocess.run(["pactl", "list", "sink-inputs"],
                             capture_output=True, text=True,
                             timeout=5).stdout
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return []
    streams = []
    app = title = None
    corked = None
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("Sink Input #"):
            if corked is False and app:
                streams.append((app, title))
            app = title = None
            corked = None
        elif line.startswith("Corked:"):
            corked = line.partition(":")[2].strip() == "yes"
        elif line.startswith("application.name ="):
            app = line.partition("= ")[2].strip().strip('"')
        elif line.startswith("media.name ="):
            title = line.partition("= ")[2].strip().strip('"')
    if corked is False and app:
        streams.append((app, title))
    return streams


def clean_tab_title(raw):
    """'(667) Artist - Title - YouTube' -> 'Artist - Title'."""
    t = re.sub(r"^\(\d+\)\s*", "", raw or "")
    t = re.sub(r"\s*-\s*YouTube\s*$", "", t)
    return t.strip() or None


def render(players):
    """(waybar payload, state-file name or None) for this snapshot.

    The bar shows the play glyph plus the track title — never the app name.
    A track counts while its source audibly plays: a Playing MPRIS player,
    or audio flowing in an uncorked sink-input without one (the Firefox
    stale-bus case, bug 1710229, using the stream's media.name as track).
    Empty otherwise, so with "hide-empty-text" the module leaves the bar.
    """
    streams = audio_streams()
    playing = [p for p in players if p["status"] == "Playing"]
    mpris_bases = {p["name"].split(".")[0].lower() for p in playing}
    cands = [(p["track"], p["name"]) for p in playing]
    for app, raw in streams:
        if app.lower() in mpris_bases:
            continue  # MPRIS already reports this app playing — trust it
        title = clean_tab_title(raw)
        if title:
            cands.append((title, None))
    if not cands:
        return {"text": "", "class": "none", "tooltip": ""}, None
    track, player_name = cands[0]
    return {
        "text": "\uf04b %s" % track,  # Nerd Font play glyph + track
        "class": "playing",
        "tooltip": "",
    }, player_name


def toggle():
    name = ""
    try:
        name = open(STATE).read().strip()
    except OSError:
        pass
    cmd = ["playerctl"] + (["-p", name] if name else []) + ["play-pause"]
    subprocess.run(cmd, capture_output=True, timeout=5)


def main():
    if "click" in sys.argv[1:]:
        toggle()
        return
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    # waybar closes our stdout on reload/exit — die silently, no traceback
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    last = None
    while True:
        players = snapshot()
        payload, player_name = render(players)
        if payload != last:
            last = payload
            if player_name:
                with open(STATE, "w") as f:
                    f.write(player_name)
            print(json.dumps(payload), flush=True)
        time.sleep(POLL)


if __name__ == "__main__":
    main()
