#!/usr/bin/env bash
# tai — project-centric agentic tmux sessions.
#
# One tmux session per project, named after the agent harness that leads it
# (e.g. hermes-myproj, pi-myproj). Default layout of the `agents` window:
#
#   +----------------------------------+--------------+
#   |                                  | monitor      |
#   | harness pane 1                   |              |
#   |                                  +--------------+
#   |                                  | term (shell) |
#   +----------------------------------+              |
#   | harness pane 2                   |              |
#   +----------------------------------+--------------+
#   | free shell (full-width work terminal, 7 rows)   |
#   +--------------------------------------------------+
#
# Usage:
#   tai                       fzf-pick an existing session
#   tai <project|path>        attach to its session (any harness), else create
#                             one with the default harness; a path (absolute,
#                             relative or cast-quoted ~) is used as-is and is
#                             NOT projects-root-relative — only a bare name is
#   tai --new <name|path>     mkdir (under $TAI_PROJECTS_DIR unless a path is
#                             given), git init, register a hermes project,
#                             build the session
#   tai --force <name>        create a duplicate session even if one exists
#                             (suffix -2, -3, ...)
#   tai -H <harness> ...      leading harness: hermes (default), pi, opencode,
#                             grok, claude, ... — an uninstalled one degrades
#                             to a plain shell in its panes
#   tai --no-project          skip the hermes project hook on --new
#   tai --no-attach           create but don't attach/switch (for scripting)
#
# Settings (environment): TAI_PROJECTS_DIR (default ~/projects),
# TAI_HARNESS (default hermes).

projects_root="${TAI_PROJECTS_DIR:-$HOME/projects}"
default_harness="${TAI_HARNESS:-hermes}"

usage() { sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; }
die() { echo "tai: $*" >&2; exit 1; }

session_exists() { tmux has-session -t="$1" 2>/dev/null; }

harness_pane_cmd() {
  # Command string for an agent pane: the harness if installed, otherwise a
  # shell that says why. Pane commands are run through the user's
  # default-command shell (fish here), so keep the fallback fish-safe.
  local h="$1"
  if command -v "$h" >/dev/null 2>&1; then
    printf '%s' "$h"
  else
    printf "echo 'tai: %s not installed — plain shell instead'; exec %s" \
      "$h" "${SHELL:-/bin/sh}"
  fi
}

create_session() { # $1 = project dir, $2 = harness; prints the session name
  local dir="$1" harness="$2"
  local safename base name i agent_cmd p1 p2 mon_id term_id shell_id

  safename="$(basename "$dir" | tr . _)"
  base="$harness-$safename"
  name="$base"
  for i in 2 3 4 5 6 7 8 9; do
    session_exists "$name" || break
    name="$base-$i"
  done
  session_exists "$name" && die "no free session name left for $base"

  agent_cmd="$(harness_pane_cmd "$harness")"

  # Create the window at the size of the client that will attach. Detached
  # sessions default to 80x24, the splits are computed against that, and the
  # later resize when the client attaches re-stretches every pane (the 5-row
  # strip balloons). Inside tmux use the current client's size; outside, the
  # real terminal size.
  if [ -n "${TMUX:-}" ]; then
    geom="$(tmux display-message -p '#{client_width} #{client_height}')"
  else
    geom="$(tput cols 2>/dev/null || echo 0) $(tput lines 2>/dev/null || echo 0)"
  fi
  local ww hh
  ww="${geom%% *}"; hh="${geom#* }"
  case "$ww" in '' | *[!0-9]*) ww=120 ;; esac
  case "$hh" in '' | *[!0-9]*) hh=40 ;; esac
  [ "$ww" -ge 10 ] 2>/dev/null || ww=120
  [ "$hh" -ge 10 ] 2>/dev/null || hh=40

  # Pane commands run as the pane's process (not typed via send-keys), so
  # there's no race with the pane's shell startup. Target everything by pane
  # ID: pane indexes start at pane-base-index (1 in ~/.tmux.conf), so a
  # hardcoded ".0" never resolves.
  p1="$(tmux new-session -dP -F '#{pane_id}' -s "$name" -n agents \
    -x "$ww" -y "$hh" -c "$dir" "$agent_cmd")"
  # bottom shell: 7 fixed rows; re-applied by the window-resized hook
  shell_id="$(tmux split-window -d -P -F '#{pane_id}' -t "$p1" -v -l 7 \
    -c "$dir")"
  # right column (30%): monitor on top, full column height at first
  mon_id="$(tmux split-window -d -P -F '#{pane_id}' -t "$p1" -h -l 30% \
    -c "$dir" tai-monitor)"
  # monitor column: term takes the bottom 75%, monitor keeps the top 25%
  term_id="$(tmux split-window -d -P -F '#{pane_id}' -t "$mon_id" -v -l 75% \
    -c "$dir")"
  # left side, agent panes stacked: agent 2 slightly taller (55%)
  p2="$(tmux split-window -d -P -F '#{pane_id}' -t "$p1" -v -l 55% \
    -c "$dir" "$agent_cmd")"

  tmux select-pane -t "$p1" -T "$harness:1"
  tmux select-pane -t "$p2" -T "$harness:2"
  tmux select-pane -t "$mon_id" -T monitor
  tmux select-pane -t "$term_id" -T term
  tmux select-pane -t "$shell_id" -T shell
  # The hook fires per resize event, often mid-stretch (that's why it's
  # delayed by 1s and serialized with flock inside tai-relayout): tmux
  # re-stretches panes whenever the client size changes, so the ratios need
  # a settling pass after each change.
  tmux set-hook -g window-resized "run-shell -d 1 'tai-relayout #{window_id}'"
  tmux select-pane -t "$p1"

  printf '%s' "$name"
}

resolve_dir() { # $1 = path or project name; prints the project directory
  # A path is used as-is (never resolved against $projects_root); only a bare
  # name falls back to the projects root. A quoted-~ path is re-joined with
  # $HOME because POSIX argv expansion only happens for unquoted ~.
  local p="$1"
  case "$p" in
    '~' | '~'/*) p="${p/#\~/$HOME}" ;;
  esac
  if [ -d "$p" ]; then
    [ "$p" = "/" ] && printf '%s' "$p" || printf '%s' "${p%/}"
  else
    [ -d "$projects_root/$p" ] || mkdir -p "$projects_root"
    printf '%s' "$projects_root/$p"
  fi
}

sessions_for() { # $1 = project safename; prints matching session names
  local s
  tmux list-sessions -F '#S' 2>/dev/null | while read -r s; do
    case "$s" in
      *"-$1" | *"-$1"-[0-9]) echo "$s" ;;
    esac
  done
}

attach() { # $1 = session name
  [ "$no_attach" -eq 1 ] && return 0
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$1"
  else
    tmux attach-session -t "$1"
  fi
}

hermes_hook() { # $1 = project name, $2 = dir; best-effort
  command -v hermes >/dev/null 2>&1 || return 0
  if ! hermes project create "$1" "$2" --use >/dev/null 2>&1; then
    hermes project add-folder "$1" "$2" --primary >/dev/null 2>&1 ||
      echo "tai: hermes project hook failed (create/add-folder)" >&2
  fi
}

harness="$default_harness"
mode="attach" # attach | new | force
positional=""
no_project=0
no_attach=0

while [ $# -gt 0 ]; do
  case "$1" in
    -H | --harness)
      [ $# -ge 2 ] || die "-H needs an argument"
      case "$2" in
        '' | *[!A-Za-z0-9_-]*) die "invalid harness name: $2" ;;
      esac
      harness="$2"
      shift 2
      ;;
    --new | -n) mode="new"; shift ;;
    --force | -f) mode="force"; shift ;;
    --no-project) no_project=1; shift ;;
    --no-attach) no_attach=1; shift ;;
    -h | --help) usage; exit 0 ;;
    --) shift; break ;;
    -*) die "unknown option: $1" ;;
    *)
      [ -z "$positional" ] || die "unexpected extra argument: $1"
      positional="$1"
      shift
      ;;
  esac
done
[ $# -eq 0 ] || die "unexpected extra argument: $1"

case "$mode" in
  new)
    [ -n "$positional" ] || die "--new needs a project name or path"
    dir="$(resolve_dir "$positional")"
    mkdir -p "$dir"
    if [ ! -d "$dir/.git" ]; then
      git -C "$dir" init -q -b main 2>/dev/null || git -C "$dir" init -q
      echo "tai: initialized git repo in $dir"
    fi
    [ "$no_project" -eq 1 ] || hermes_hook "$(basename "$dir" | tr . _)" "$dir"
    name="$(create_session "$dir" "$harness")" || exit 1
    echo "tai: created $name for $dir"
    attach "$name"
    ;;

  force)
    [ -n "$positional" ] || die "--force needs a project name or path"
    dir="$(resolve_dir "$positional")"
    [ -d "$dir" ] || die "directory not found: $dir"
    name="$(create_session "$dir" "$harness")" || exit 1
    echo "tai: created $name for $dir"
    attach "$name"
    ;;

  attach)
    if [ -z "$positional" ]; then
      # No argument: fuzzy-pick any existing session.
      pick="$(tmux list-sessions -F '#S' 2>/dev/null |
        fzf --prompt='tai session> ')" || exit 0
      [ -n "$pick" ] || die "no tmux sessions running"
      attach "$pick"
      exit 0
    fi

    dir="$(resolve_dir "$positional")"
    [ -d "$dir" ] || die "unknown project '$positional' (no directory). Try: tai --new $positional"

    matches="$(sessions_for "$(basename "$dir" | tr . _)")"
    count="$(printf '%s\n' "$matches" | grep -c .)"
    case "$count" in
      0)
        name="$(create_session "$dir" "$harness")" || exit 1
        echo "tai: created $name for $dir"
        attach "$name"
        ;;
      1) attach "$matches" ;;
      *)
        pick="$(printf '%s\n' "$matches" | fzf --prompt='tai session> ')" || exit 0
        attach "$pick"
        ;;
    esac
    ;;
esac
