// Waybar config — dot-files Arch desktop (AMD Ryzen + RX 7900 XT)
// Linked from ~/.config/waybar/config
{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 0,

    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "sway/window"
    ],
    "modules-center": [],
    "modules-right": [
        "tray",
        "custom/keepawake",
        "custom/media",
        "pulseaudio",
        "custom/bluetooth",
        "custom/net-rate",
        "custom/net-health",
        "custom/spark-cpu",
        "custom/spark-tcpu",
        "custom/spark-gpu",
        "custom/spark-mem",
        "clock"
    ],

    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{name}"
    },

    "sway/mode": {
        "format": " {} "
    },

    "sway/window": {
        "max-length": 60
    },

    "clock": {
        "format": "{:%a %b %d %Y  %H:%M}",
        "tooltip": false,
        "on-click": "sh -c 'exec $HOME/bin/waybar-calendar toggle'"
    },

    "custom/spark-cpu": {
        // usage history chart on hover (bin/waybar-spark); "!" marks alert
        // states. Threshold keys are NOT waybar options — they are the single
        // source of truth read by waybar-spark (class + "!") and
        // bin/waybar-alerts (notifications)
        "exec": "sh -c 'exec $HOME/bin/waybar-spark cpu'",
        "return-type": "json",
        "format": "{text}",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },

    "custom/spark-tcpu": {
        "exec": "sh -c 'exec $HOME/bin/waybar-spark tcpu'",
        "return-type": "json",
        "format": "{text}",
        "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
        "warning-threshold": 75,
        "critical-threshold": 85
    },

    "custom/spark-gpu": {
        "exec": "sh -c 'exec $HOME/bin/waybar-spark gpu'",
        "return-type": "json",
        "format": "{text}",
        "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
        "warning-threshold": 80,
        "critical-threshold": 90
    },

    "custom/spark-mem": {
        "exec": "sh -c 'exec $HOME/bin/waybar-spark mem'",
        "return-type": "json",
        "format": "{text}",
        "states": {
            "warning": 80,
            "critical": 90
        }
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "MUTE",
        "on-click": "pavucontrol",
        "tooltip-format": "{desc}"
    },

    // Bluetooth (bin/waybar-bluetooth): icons of connected devices, full
    // state on hover. Click opens the device menu (bin/waybar-bluetooth-menu:
    // connect / disconnect / scan / pair). signal 7 → instant refresh after
    // menu actions; interval is the slow fallback poll.
    "custom/bluetooth": {
        "exec": "sh -c 'exec $HOME/bin/waybar-bluetooth'",
        "return-type": "json",
        "format": "{text}",
        "interval": 10,
        "signal": 7,
        "on-click": "sh -c 'exec $HOME/bin/waybar-bluetooth-menu toggle'",
        "on-click-right": "sh -c 'exec $HOME/bin/waybar-bluetooth-menu toggle'"
    },

    "custom/net-rate": {
        "exec": "sh -c 'exec $HOME/bin/waybar-net-rate'",
        "return-type": "json",
        "format": "{text}"
    },

    "custom/net-health": {
        "exec": "sh -c 'exec $HOME/bin/waybar-net-health'",
        "return-type": "json",
        "format": "{text}",
        "interval": 10,
        "on-click": "sh -c 'exec $HOME/bin/waybar-net-health'"
    },

    "custom/keepawake": {
        "exec": "sh -c 'exec $HOME/bin/keepawake status'",
        "return-type": "json",
        "format": "{text}",
        "interval": 60,
        "signal": 8,
        "on-click": "sh -c 'exec $HOME/bin/keepawake toggle'"
    },

    "custom/media": {
        "exec": "sh -c 'exec $HOME/bin/waybar-media'",
        "return-type": "json",
        "format": "{text}",
        "max-length": 70,
        "escape": true,
        "hide-empty-text": true,
        "on-click": "sh -c 'exec $HOME/bin/waybar-media click'",
        "on-click-right": "sh -c 'exec $HOME/bin/waybar-media-menu toggle'"
    },

    "tray": {
        "spacing": 8
    }
}
