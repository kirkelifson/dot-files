{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "padding": { "top": 1, "left": 2, "right": 4 }
  },

  "display": {
    "separator": " ",
    "key": { "width": 16 },
    "color": { "keys": "blue", "title": "magenta" },
    "percent": {
      "type": 3,
      "color": { "green": "green", "yellow": "light_yellow", "red": "light_red" }
    },
    "bar": {
      "width": 12,
      "char": { "elapsed": "█", "total": "░" },
      "border": { "left": "[", "right": "]" }
    }
  },

  "modules": [
    "break",

    {
      "type": "title",
      "color": { "user": "blue", "at": "default", "host": "magenta" }
    },
    { "type": "custom", "format": "──────────────────────────────" },

    { "type": "os",       "key": "\uf303  OS",       "keyColor": "blue" },
    { "type": "kernel",   "key": "\uf013  Kernel",   "keyColor": "cyan" },
    { "type": "wm",       "key": "\uf2d0  WM",       "keyColor": "magenta" },
    { "type": "terminal", "key": "\uf120  Terminal", "keyColor": "yellow" },
    { "type": "shell",    "key": "\uf121  Shell",    "keyColor": "green" },
    { "type": "packages", "key": "\uf187  Packages", "keyColor": "red" },

    "break",

    {
      "type": "cpu",
      "key": "\uf2db  CPU",
      "keyColor": "blue",
      "temp": true,
      "showPeCoreCount": true
    },
    { "type": "gpu",     "key": "\uf26c  GPU",     "keyColor": "magenta" },
    { "type": "memory",  "key": "\uf1c0  Memory",  "keyColor": "cyan" },
    { "type": "swap",    "key": "\uf021  Swap",    "keyColor": "green" },
    {
      "type": "disk",
      "key": "\uf0a0  Disk (/)",
      "keyColor": "yellow",
      "folders": "/",
      "useAvailable": true
    },
    { "type": "uptime", "key": "\uf017  Uptime", "keyColor": "red" },
    {
      "type": "localip",
      "key": "\uf1eb  Local IP",
      "keyColor": "blue",
      "showIpv6": false,
      "showPrefixLen": false
    },

    "break",

    { "type": "colors", "symbol": "block" }
  ]
}
