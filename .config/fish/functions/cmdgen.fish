function cmdgen --description 'Replace the current commandline text with a shell command generated by Hermes'
    set -l text (commandline -b)
    if test -z "$text"
        echo 'cmdgen: nothing typed — write what you want first' >&2
        return 1
    end

    printf '\nhermes is thinking…\n' >&2

    set -l prompt "Convert the following into a single fish shell command line. \
It may use pipes, redirections, semicolons, &&, ||, subshells, etc. \
Reply with ONLY the command itself: no prose, no explanation, no markdown code fences. \
Wish: $text"

    # -z = oneshot (print only the final response); --ignore-rules skips
    # memory/skills injection for a fast, clean one-shot. Flags must come
    # BEFORE -z: argparse treats any '--'-prefixed token after -z as a flag.
    set -l out (hermes --ignore-rules -m z-ai/glm-5.3-flash --provider nous --reasoning medium -z "$prompt" 2>/dev/null | string collect)

    # Strip markdown fences if the model added them anyway.
    set -l lines (string match -v --regex '^```' -- $out)
    set -l cmd (string trim -- (string join '\n' -- $lines))

    if test -z "$cmd"
        echo 'cmdgen: hermes returned nothing' >&2
        return 1
    end

    # Replace the typed text with the command, but do NOT execute it.
    commandline -r "$cmd"
    commandline -f repaint
end
